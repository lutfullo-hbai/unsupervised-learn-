# PDF Analyzer — .env.example
# Nusxalang:  cp .env.example .env
# .env hech qachon git'ga commit QILINMAYDI (.gitignore'ga qarang).

# ============================================================
# LLM Provider (M11)
# Pluggable: ollama | openai | azure | groq | vllm
# Hozir default: ollama (lokal, bepul)
# ============================================================
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=2
OLLAMA_NUM_CTX=4096

# Cloud provider'lar (keyinchalik — hozir kerak emas)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# LLM javob tili (M11: output_language)
OUTPUT_LANGUAGE=uz

# ============================================================
# Embeddings (M9)
# USE_MULTILINGUAL=true  → ko'p tilli PDF (o'zbek/rus/ingliz aralash)
# USE_MULTILINGUAL=false → faqat ingliz yoki tarjima qilingan matn
# ============================================================
USE_MULTILINGUAL=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MULTILINGUAL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=16
# Model keshi (Docker uchun)
HF_HOME=~/.cache/huggingface

# ============================================================
# Translation (M-T) — PLUGGABLE, DEFAULT OCHIQ
# ============================================================
# QAT'IY QOIDA: tarjima faqat document yoki page darajasida.
# Hech qachon chunk darajasida emas!
TRANSLATION_ENABLED=false
# none (alias: noop) | google_translate
# `libre_translate` QO'LLANILMAYDI — provider yo'q, Settings rad etadi.
TRANSLATION_PROVIDER=none
TRANSLATION_TARGET=en
# document | page   (chunk QO'LLANMAYDI)
TRANSLATION_BATCH_BY=page
GOOGLE_TRANSLATE_TIMEOUT=30
GOOGLE_TRANSLATE_MAX_RETRIES=2

# ============================================================
# Application (M13)
# ============================================================
APP_NAME=PDF Analyzer
APP_VERSION=0.1.0

# ============================================================
# PDF (M2)
# ============================================================
# Jami belgi chegarasi: ostida bo'lsa ScannedPdfError (matn qatlami yo'q).
# Juda past -> oddiy PDF rad etiladi. Juda yuqori -> skanerlangan o'tib ketadi.
MIN_TOTAL_CHARS=100
DEBUG=false
LOG_LEVEL=INFO
MAX_UPLOAD_MB=25

# ============================================================
# Chunking (M4)
# ============================================================
# Eslatma: bu nomlar app/core/config.py dagi maydonlar bilan
# BIR XIL bo'lishi shart. Nom mos kelmasa `.env` qiymati
# jim qoldiriladi (Settings: extra="ignore").
CHUNK_SIZE=800
CHUNK_OVERLAP=200
MIN_CHUNK_CHARS=10

# ============================================================
# TF-IDF (M5)
# ============================================================
TFIDF_MAX_FEATURES=50000
# (tuple formatda: 1,2)

# ============================================================
# Clustering (M6/M7)
# ============================================================
N_CLUSTERS=
KMEANS_RANDOM_STATE=42

# ============================================================
# Kelajak uchun (hozir config'da YO'Q — M11/M18 da qo'shiladi)
# ============================================================
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GROQ_API_KEY=
# GROQ_MODEL=
# OUTPUT_LANGUAGE=uz

# ============================================================
# Faqat boshqa tool'lar uchun (Settings emas)
# ============================================================
# Frontend (M14) FastAPI manzilini shundan oladi
API_URL=http://localhost:8000
# Model keshi (Docker, M16)
HF_HOME=~/.cache/huggingface